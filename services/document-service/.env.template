# Document Service environment template

# Service
PORT=3004
NODE_ENV=development
LOG_LEVEL=info

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=postgres
DB_SCHEMA=documents
DB_SYNC=false

# JWT
JWT_SECRET=change-me-in-production
IAM_ISSUER=http://localhost:8080
JWKS_URI=http://localhost:8080/.well-known/jwks.json
JWT_AUDIENCES=insurance-platform

# Storage
DOCUMENT_UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=10485760
DOCUMENT_DOWNLOAD_SECRET=change-me-in-production

# Optional: encryption at rest
DOCUMENT_ENCRYPT_AT_REST=false
DOCUMENT_ENCRYPTION_KEY=

# Optional: virus/malware scanning (currently a placeholder extension point)
DOCUMENT_SCAN_ENABLED=false

# Optional: OCR / document AI extraction
OCR_ENGINE_URL=http://localhost:3005
DOCUMENT_AI_SERVICE_URL=http://localhost:3005

# Kafka (optional)
KAFKA_BROKERS=
KAFKA_CONSUMER_GROUP=document-claims-v1
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
