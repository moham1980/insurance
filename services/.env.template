# Standard Environment Variables Template for All Services
# This file defines the standard environment variables that should be used across all services

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=insurance_platform
DB_SCHEMA=public
DB_SYNC=false

# Service Configuration
PORT=3000
NODE_ENV=production

# Kafka Configuration
KAFKA_BROKERS=kafka:9092
KAFKA_CONSUMER_GROUP=${SERVICE_NAME}-group

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=1h

# Tenant Configuration
DEFAULT_TENANT_ID=default

# Observability
JAEGER_HOST=jaeger
JAEGER_PORT=6831

# Redis (for caching if needed)
REDIS_HOST=redis
REDIS_PORT=6379

# Feature Flags
FEATURE_FLAGS_URL=http://feature-flags-service:3011

# API Gateway
API_GATEWAY_URL=http://api-gateway:3000

# External Integrations
# Sanhab (Central Insurance of Iran)
SANHAB_WSDL_URL=https://sanhab.ir/wsdl
SANHAB_API_KEY=
SANHAB_CERT_PATH=
SANHAB_CERT_KEY_PATH=
SANHAB_CA_PATH=
SANHAB_TIMEOUT_MS=30000
SANHAB_USE_MOCK=false

# OTP / SMS Providers
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Kavenegar (Iran SMS provider)
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER_NUMBER=

# Payment Gateway
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_SECRET=

# Service-specific URLs (set per service)
# AUTH_SERVICE_URL=http://auth-service:3001
# POLICY_SERVICE_URL=http://policy-service:3007
# CLAIMS_SERVICE_URL=http://claims-service:3002
# etc.
