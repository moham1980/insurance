# Example environment variables for the old/insurance API gateway
# to accept both ecosystem IAM (RS256) and legacy auth-service (HS256) tokens.

# --- Ecosystem IAM integration ---
# Comma-separated list of accepted JWT issuers.
# Ecosystem IAM: http://localhost:8080
# Legacy insurance auth-service: http://localhost:18001
JWT_ISSUERS=http://localhost:8080,http://localhost:18001

# Comma-separated list of accepted JWT audiences.
# Ecosystem IAM: modern-banking
# Legacy insurance auth-service: insurance-platform
JWT_AUDIENCES=modern-banking,insurance-platform

# JWKS endpoint for RS256 token validation.
# For ecosystem IAM this is the well-known JWKS URI.
JWKS_URI=http://localhost:8080/.well-known/jwks.json

# --- Legacy HS256 fallback ---
# Shared secret for validating HS256 tokens issued by the legacy auth-service.
JWT_SECRET=change-me-in-production

# --- Upstream service URLs ---
# Adjust these if the legacy services run on different ports/hosts.
AUTH_SERVICE_URL=http://localhost:18001
CLAIMS_SERVICE_URL=http://localhost:18002
POLICY_SERVICE_URL=http://localhost:18007
PAYMENTS_URL=http://localhost:18004
FRAUD_SERVICE_URL=http://localhost:18009
DOCUMENT_SERVICE_URL=http://localhost:18008
ORCHESTRATOR_URL=http://localhost:18010
FEATURE_FLAGS_URL=http://localhost:18011
PARTY_KYC_URL=http://localhost:18006
COMPLAINTS_SERVICE_URL=http://localhost:18013
REINSURANCE_SERVICE_URL=http://localhost:18017
PRODUCT_SERVICE_URL=http://localhost:18018
UNDERWRITING_SERVICE_URL=http://localhost:18032
BILLING_SERVICE_URL=http://localhost:18039
NOTIFICATION_SERVICE_URL=http://localhost:18037

# --- Gateway runtime ---
PORT=18000
NODE_ENV=development
GATEWAY_SIGNATURE_SECRET=your-gateway-signature-secret-change-in-production

# Optional mapping from ecosystem tenant strings to legacy internal UUID tenants
# Format: name1:uuid1,name2:uuid2
TENANT_UUID_MAP=shakhsi:11111111-1111-1111-1111-111111111111
