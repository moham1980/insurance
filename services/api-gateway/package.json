{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "API Gateway - Reverse Proxy with routing and auth",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "bun run build && node dist/main.js",
    "start": "node dist/main.js",
    "migrate": "bun run dist/migrate.js",
    "migrate:build": "bun run build && bun run dist/migrate.js"
  },
  "dependencies": {
    "@insurance/shared": "1.0.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-fastify": "^10.3.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/http-proxy": "^9.4.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "ioredis": "^5.3.2",
    "@nestjs/typeorm": "^10.0.2",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/jsonwebtoken": "^9.0.5",
    "typescript": "^5.3.3"
  }
}
