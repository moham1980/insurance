# Ecosystem IAM / JWT configuration

# JWKS endpoint used to validate RS256 ecosystem JWT tokens from IAM
JWKS_URI=http://localhost:8080/.well-known/jwks.json

# Issuer URL expected on ecosystem JWT tokens
IAM_ISSUER=http://localhost:8080

# Audience expected on ecosystem JWT tokens (defaults to modern-banking for IAM-issued tokens)
JWT_AUDIENCES=modern-banking

# Fallback HS256 shared secret for legacy / local tokens
JWT_SECRET=change-this-in-production

# Optional mapping from ecosystem tenant strings to legacy internal UUID tenants
# Format: name1:uuid1,name2:uuid2
TENANT_UUID_MAP=shakhsi:11111111-1111-1111-1111-111111111111
