{
  "name": "underwriting-service",
  "version": "1.0.0",
  "description": "Underwriting Service - risk assessment decisions (approve/reject) with work items and audit, Iran-aligned (1404), no AI dependency",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "bun run src/main.ts",
    "start": "bun run dist/main.js",
    "migrate": "bun run dist/migrate.js",
    "migrate:build": "bun run build && bun run dist/migrate.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@insurance/shared": "1.0.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-fastify": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/typeorm": "^10.0.2",
    "@fastify/helmet": "^11.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@nestjs/testing": "^10.3.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1"
  }
}
