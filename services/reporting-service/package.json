{
  "name": "reporting-service",
  "version": "1.0.0",
  "description": "Reporting Service - KPI snapshots and dashboards",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "bun run src/main.ts",
    "start": "bun run dist/main.js",
    "migrate": "bun run dist/migrate.js",
    "migrate:build": "bun run build && bun run dist/migrate.js"
  },
  "dependencies": {
    "@insurance/shared": "1.0.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-fastify": "^10.3.0",
    "@nestjs/typeorm": "^10.0.2",
    "kafkajs": "^2.2.4",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/jsonwebtoken": "^9.0.5",
    "typescript": "^5.3.3"
