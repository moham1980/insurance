{
  "dashboard": {
    "id": null,
    "title": "Insurance System Monitoring",
    "tags": ["insurance", "monitoring", "production"],
    "style": "dark",
    "timezone": "Asia/Tehran",
    "editable": true,
    "hideControls": false,
    "graphTooltip": 1,
    "panels": [
      {
        "id": 1,
        "title": "API Gateway Request Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total{service=\"api-gateway\"}[5m])",
            "legendFormat": "{{method}} {{path}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "Requests/sec"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "API Gateway Response Time",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, http_request_duration_seconds_bucket{service=\"api-gateway\"})",
            "legendFormat": "95th percentile",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, http_request_duration_seconds_bucket{service=\"api-gateway\"})",
            "legendFormat": "50th percentile",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Duration"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Service Health Status",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=~\".*-service\"}",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 4,
          "w": 24,
          "x": 0,
          "y": 8
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area"
        }
      },
      {
        "id": 4,
        "title": "Policy Service Metrics",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total{service=\"policy-service\"}[5m])",
            "legendFormat": "Request Rate",
            "refId": "A"
          },
          {
            "expr": "rate(policy_creations_total[5m])",
            "legendFormat": "Policy Creations",
            "refId": "B"
          },
          {
            "expr": "rate(policy_renewals_total[5m])",
            "legendFormat": "Policy Renewals",
            "refId": "C"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 12
        }
      },
      {
        "id": 5,
        "title": "Claims Service Metrics",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total{service=\"claims-service\"}[5m])",
            "legendFormat": "Request Rate",
            "refId": "A"
          },
          {
            "expr": "rate(claim_submissions_total[5m])",
            "legendFormat": "Claim Submissions",
            "refId": "B"
          },
          {
            "expr": "rate(claim_approvals_total[5m])",
            "legendFormat": "Claim Approvals",
            "refId": "C"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 12
        }
      },
      {
        "id": 6,
        "title": "Fraud Service Metrics",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total{service=\"fraud-service\"}[5m])",
            "legendFormat": "Request Rate",
            "refId": "A"
          },
          {
            "expr": "rate(fraud_detections_total[5m])",
            "legendFormat": "Fraud Detections",
            "refId": "B"
          },
          {
            "expr": "avg(fraud_score)",
            "legendFormat": "Avg Fraud Score",
            "refId": "C"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 12
        }
      },
      {
        "id": 7,
        "title": "Database Connection Pool",
        "type": "graph",
        "targets": [
          {
            "expr": "pg_stat_activity_count{datname=~\".*\"}",
            "legendFormat": "{{datname}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 20
        }
      },
      {
        "id": 8,
        "title": "Kafka Consumer Lag",
        "type": "graph",
        "targets": [
          {
            "expr": "kafka_consumer_lag{group=~\".*\"}",
            "legendFormat": "{{topic}} - {{group}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 20
        }
      },
      {
        "id": 9,
        "title": "Memory Usage by Service",
        "type": "graph",
        "targets": [
          {
            "expr": "container_memory_usage_bytes{job=~\".*-service\"} / 1024 / 1024",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "decmbytes",
            "label": "Memory (MB)"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 28
        }
      },
      {
        "id": 10,
        "title": "CPU Usage by Service",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{job=~\".*-service\"}[5m]) * 100",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "percent",
            "label": "CPU %"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 28
        }
      },
      {
        "id": 11,
        "title": "Error Rate by Service",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total{status=~\"5..\"}[5m]) / rate(http_requests_total[5m]) * 100",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "percent",
            "label": "Error Rate %"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 36
        }
      },
      {
        "id": 12,
        "title": "Circuit Breaker Status",
        "type": "stat",
        "targets": [
          {
            "expr": "circuit_breaker_state{service=~\".*\"}",
            "legendFormat": "{{service}} - {{name}}",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 36
        },
        "options": {
          "colorMode": "value",
          "graphMode": "none"
        }
      },
      {
        "id": 13,
        "title": "Sanhab Integration Status",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(sanhab_requests_total[5m])",
            "legendFormat": "Request Rate",
            "refId": "A"
          },
          {
            "expr": "rate(sanhab_errors_total[5m])",
            "legendFormat": "Error Rate",
            "refId": "B"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 44
        }
      },
      {
        "id": 14,
        "title": "SMS Gateway Status",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(sms_sent_total{provider=~\".*\"}[5m])",
            "legendFormat": "{{provider}}",
            "refId": "A"
          },
          {
            "expr": "rate(sms_failed_total{provider=~\".*\"}[5m])",
            "legendFormat": "{{provider}} - Failed",
            "refId": "B"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 44
        }
      },
      {
        "id": 15,
        "title": "Payment Gateway Status",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(payment_transactions_total[5m])",
            "legendFormat": "Transaction Rate",
            "refId": "A"
          },
          {
            "expr": "rate(payment_successes_total[5m])",
            "legendFormat": "Success Rate",
            "refId": "B"
          },
          {
            "expr": "rate(payment_failures_total[5m])",
            "legendFormat": "Failure Rate",
            "refId": "C"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 52
        }
      },
      {
        "id": 16,
        "title": "ML Model Performance",
        "type": "graph",
        "targets": [
          {
            "expr": "ml_model_accuracy{model=\"fraud_detection\"}",
            "legendFormat": "Accuracy",
            "refId": "A"
          },
          {
            "expr": "ml_model_precision{model=\"fraud_detection\"}",
            "legendFormat": "Precision",
            "refId": "B"
          },
          {
            "expr": "ml_model_recall{model=\"fraud_detection\"}",
            "legendFormat": "Recall",
            "refId": "C"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 52
        }
      }
    ],
    "refresh": "30s",
    "schemaVersion": 16,
    "version": 1,
    "links": [],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    }
  }
}
