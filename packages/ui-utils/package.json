{
  "name": "@insurance/ui-utils",
  "version": "0.1.0",
  "description": "Shared UI utilities — formatting, hooks, helpers",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cn": {
      "types": "./dist/cn.d.ts",
      "default": "./dist/cn.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "default": "./dist/hooks/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.0",
    "date-fns-jalali": "^4.1.0-0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "5.3.3"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  }
}
